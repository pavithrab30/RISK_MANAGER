# Copy this file to .env and fill in your free-tier API keys.
# Nothing here is hardcoded in source - config.py reads from environment only.

# --- LLM providers (both free-tier, no credit card required) ---
# Groq: https://console.groq.com/keys  (used for answer generation + query decomposition)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google AI Studio: https://aistudio.google.com/apikey  (used as the independent eval judge,
# and as a multimodal fallback for figure/chart questions Docling can't structure)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# --- Storage paths (local, no external services required) ---
STORAGE_DIR=./storage
CHROMA_DIR=./storage/chroma
SQLITE_PATH=./storage/docintel.sqlite3
UPLOAD_DIR=./storage/uploads

# --- Retrieval / model config ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
TOP_K_DENSE=20
TOP_K_KEYWORD=20
TOP_K_RERANKED=8
GRAPH_EXPANSION_ENABLED=true
QUERY_DECOMPOSITION_ENABLED=true

# --- App ---
LOG_LEVEL=INFO
ENV=development
CORS_ORIGINS=http://localhost:5173
