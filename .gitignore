# Node / frontend build artifacts
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*

# Frontend env (has VITE_API_BASE_URL pointing to localhost)
frontend/.env

# Unused assets
frontend/src/assets/vite.svg
frontend/src/assets/hero.png

